# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Signs the login token (ADR-0009). At least 32 characters: openssl rand -base64 48
JWT_SECRET=

# MongoDB (ADR-0002) — `docker compose up -d` from the repo root
MONGO_URL=mongodb://localhost:27017/fishtank_dev

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
